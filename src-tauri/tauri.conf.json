{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AION2 Task Manager",
  "version": "0.7.0",
  "identifier": "com.founderha.aion2taskmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AION2 Task Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#0d1424"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "FounderHA",
    "shortDescription": "Controle de tarefas diárias e semanais do Aion 2",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2Q0M4RUU5MTA2MzNGNkMKUldSc1AyTVE2WTdNTnBjQnlVQ1Q2ZXdmNUVNUStQUldDQitpallrWVBKSVRWZnRrOW1DcGdLSE4K",
      "endpoints": [
        "https://github.com/FounderHA/AION2TaskManager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
